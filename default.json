{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Organisation-wide Renovate defaults. Contains only some security best practices (opt-out).",
  "extends": [
    "config:recommended",
    "security:minimumReleaseAgeNpm",
    "helpers:pinGitHubActionDigests",
    "abandonments:recommended",
    ":configMigration"
    ],
  "commitMessagePrefix": "⬆️",
  "labels": ["dependencies"],
  "minimumReleaseAge": "3 days",
  "rangeStrategy": "bump",
  "platformAutomerge": false,
  "packageRules": [
    {
      "description": "Pin digests for Dockerfile and Docker Compose.",
      "matchManagers": ["dockerfile", "docker-compose"],
      "pinDigests": true
    }
  ]
}
